# Ghostty config — Phase 2 (agentic dev workbench)
# All options validated against Ghostty 1.3.1. Stow-owned: real file in ~/dotfiles.

# --- Font (TERM-01, TERM-04) ---
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# Ligatures are ON by default (D-02). To disable, uncomment:
# font-feature = -calt
# font-feature = -liga
# font-feature = -dlig
# Fallback if glyphs clip/oversize (D-03): use the single-cell Mono family instead:
# font-family = "JetBrainsMono Nerd Font Mono"

# --- Theme (TERM-02) — Vesper (near-black #101010, warm minimal accents) ---
# NOTE: Ghostty resolves the built-in theme by its EXACT +list-themes name.
theme = Vesper

# --- Auto-launch herdr (agent multiplexer, replaces tmux) ---
# Every new Ghostty window drops straight into the persistent herdr session.
# herdr with no args launches-or-attaches, so panes/agents survive window close.
# Caps Lock (remapped to F18 by Karabiner) passes through untouched as the herdr prefix.
command = /opt/homebrew/bin/herdr

# --- Alt keys + clipboard (TERM-03) ---
macos-option-as-alt = true
clipboard-write = allow

# --- Comfort baseline (D-07) — no opacity/blur/background gimmicks ---
cursor-style = block
cursor-style-blink = true
window-padding-x = 10
window-padding-y = 8
mouse-hide-while-typing = true
