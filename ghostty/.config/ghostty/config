# Ghostty config — Phase 2 (agentic dev workbench)
# All options validated against Ghostty 1.3.1. Stow-owned: real file in ~/dotfiles.

# --- Font (TERM-01, TERM-04) ---
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# Ligatures are ON by default (D-02). To disable, uncomment:
# font-feature = -calt
# font-feature = -liga
# font-feature = -dlig
# Fallback if glyphs clip/oversize (D-03): use the single-cell Mono family instead:
# font-family = "JetBrainsMono Nerd Font Mono"

# --- Theme (TERM-02) — black background, vibrant ANSI text ---
# TokyoNight supplies the vivid 16-color palette (so `ls`, bat, and syntax pop),
# then we override the background to near-black — dark, not purple.
theme = TokyoNight Night
background = #0a0a0a
foreground = #c8d3f5
# Slightly brighten the selection so it reads on pure black.
selection-background = #2d3f76

# --- Auto-launch herdr (agent multiplexer, replaces tmux) ---
# Every new Ghostty window drops straight into the persistent herdr session.
# herdr with no args launches-or-attaches, so panes/agents survive window close.
# Caps Lock (remapped to F18 via hidutil login agent) passes through as the herdr prefix.
command = /opt/homebrew/bin/herdr

# --- Alt keys + clipboard (TERM-03) ---
macos-option-as-alt = true
clipboard-write = allow

# --- Styler: pimped-out look ---
# Translucent, blurred background (macOS vibrancy) — TokyoNight colors glow through.
background-opacity = 0.92
background-blur-radius = 24
# Wide-gamut P3 makes the TokyoNight palette noticeably more vivid on modern displays.
window-colorspace = display-p3
# Brighten bold text to the bright ANSI variant — more color pop in the shell/TUIs.
bold-is-bright = true
# Crisper glyphs on Retina.
font-thicken = true
# Dim inactive Ghostty splits (herdr manages its own panes, so this is mostly cosmetic).
unfocused-split-opacity = 0.85

# --- Cursor + window chrome ---
cursor-style = block
cursor-style-blink = true
macos-titlebar-style = tabs
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
mouse-hide-while-typing = true
